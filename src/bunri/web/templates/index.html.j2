<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bunri</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    background: #faf6f0;
    color: #3a322c;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans",
      "Yu Gothic", Arial, sans-serif;
  }
  header.sw-header {
    padding: 20px 24px;
    background: #fffdfa;
    border-bottom: 1px solid #f1e8da;
  }
  h1.sw-title {
    margin: 0 0 4px;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .sw-sub { margin: 0; color: #8a7f74; font-size: 0.85rem; }
  main.sw-main {
    padding: 22px 24px 40px;
    max-width: 760px;
  }
  section.sw-section { margin-bottom: 28px; }
  h2.sw-h2 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #6f665c;
    margin: 0 0 12px;
  }

  .sw-dropzone {
    border: 2px dashed #e6d9c4;
    border-radius: 16px;
    padding: 34px 16px;
    text-align: center;
    color: #8a7f74;
    background: #ffffff;
    box-shadow: 0 2px 10px rgba(120, 90, 60, 0.06);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .sw-dropzone:hover { background: #fffaf3; border-color: #e2674e; box-shadow: 0 4px 14px rgba(226, 103, 78, 0.12); }
  .sw-dropzone.is-dragover {
    background: #fdece7;
    border-color: #e2674e;
    color: #3a322c;
  }
  .sw-dropzone p { margin: 0; font-size: 0.95rem; }
  .sw-dropzone .sw-dropzone-sub { margin-top: 6px; font-size: 0.78rem; color: #b3a99c; }

  .sw-confirm {
    margin-top: 16px;
    border: 1px solid #f1e8da;
    border-radius: 14px;
    padding: 16px 18px;
    background: #ffffff;
    box-shadow: 0 2px 10px rgba(120, 90, 60, 0.06);
  }
  .sw-confirm[hidden] { display: none; }
  .sw-confirm-filename {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 8px;
    word-break: break-all;
  }
  .sw-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .sw-row > label {
    min-width: 4.5em;
    color: #6f665c;
    font-size: 0.85rem;
    font-weight: 600;
  }
  input.sw-title-input {
    flex: 1 1 auto;
    min-width: 200px;
    font: inherit;
    font-size: 0.9rem;
    padding: 8px 12px;
    border: 1px solid #e6d9c4;
    border-radius: 10px;
  }
  fieldset.sw-targets {
    border: 0;
    padding: 0;
    margin: 0 0 12px;
  }
  fieldset.sw-targets legend {
    color: #6f665c;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 7px;
  }
  .sw-target-options { display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .sw-target-option { font-size: 0.85rem; white-space: nowrap; }
  button.sw-btn {
    font: inherit;
    font-size: 0.9rem;
    padding: 8px 18px;
    border: 1px solid #e6d9c4;
    background: #ffffff;
    border-radius: 999px;
    cursor: pointer;
    color: #3a322c;
  }
  button.sw-btn:hover:not(:disabled) { background: #fff7ee; border-color: #e2674e; }
  button.sw-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  button.sw-btn-primary {
    background: #e2674e;
    border-color: #e2674e;
    color: #fffaf6;
    font-weight: 700;
  }
  button.sw-btn-primary:hover:not(:disabled) { background: #d1553d; border-color: #d1553d; }
  .sw-upload-error {
    color: #c0392b;
    font-size: 0.82rem;
    margin-top: 8px;
  }

  ul.sw-job-list { list-style: none; margin: 0; padding: 0; }
  li.sw-job {
    border: 1px solid #f1e8da;
    border-radius: 14px;
    margin-bottom: 10px;
    background: #ffffff;
    box-shadow: 0 2px 10px rgba(120, 90, 60, 0.05);
    overflow: hidden;
  }
  button.sw-job-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
  }
  button.sw-job-toggle:hover { background: #fffaf3; }
  button.sw-job-toggle:focus-visible {
    outline: 2px solid #e2674e;
    outline-offset: -2px;
  }
  .sw-job-title {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .sw-job-summary {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sw-job-summary::-webkit-scrollbar { display: none; }
  button.sw-job-toggle[aria-expanded="true"] .sw-job-summary { display: none; }
  .sw-job-chevron {
    margin-left: auto;
    color: #8a7f74;
    font-size: 0.8rem;
  }
  button.sw-job-toggle[aria-expanded="true"] .sw-job-chevron { transform: rotate(180deg); }
  .sw-job-content { padding: 0 16px 14px; }
  .sw-job-content[hidden] { display: none; }
  .sw-target-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 10px;
  }
  .sw-target-label { min-width: 5em; font-size: 0.85rem; font-weight: 600; }
  .sw-badge {
    font-size: 0.78rem;
    padding: 3px 12px;
    border-radius: 999px;
    background: #f1ece3;
    color: #8a7f74;
    white-space: nowrap;
    font-weight: 600;
  }
  .sw-badge-queued { background: #f1ece3; color: #8a7f74; }
  .sw-badge-running { background: #fdeee8; color: #c9502f; }
  .sw-badge-done { background: #e3f3ef; color: #1f6f64; }
  .sw-badge-error { background: #fbe9e6; color: #c0392b; }
  .sw-summary-badge { padding: 2px 8px; font-size: 0.72rem; }
  a.sw-open-link {
    font-size: 0.85rem;
    color: #2f8f83;
    text-decoration: none;
    font-weight: 600;
  }
  a.sw-open-link:hover { text-decoration: underline; }
  details.sw-error-details {
    margin-top: 8px;
    font-size: 0.8rem;
    color: #8a7f74;
  }
  details.sw-error-details summary {
    cursor: pointer;
    color: #c0392b;
  }
  details.sw-error-details pre {
    white-space: pre-wrap;
    word-break: break-all;
    background: #fbf8f3;
    border: 1px solid #f1e8da;
    border-radius: 10px;
    padding: 10px 12px;
    margin: 8px 0 0;
    font-size: 0.75rem;
  }
  .sw-delete-area {
    display: flex;
    justify-content: flex-end;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #f1e8da;
  }
  button.sw-delete-song-btn {
    color: #a63d31;
    border-color: #e8b8af;
    background: #fffafa;
  }
  button.sw-delete-song-btn:hover:not(:disabled) {
    color: #8f2e24;
    border-color: #c9502f;
    background: #fbe9e6;
  }
  dialog.sw-delete-dialog {
    width: min(480px, calc(100% - 32px));
    border: 1px solid #e8b8af;
    border-radius: 18px;
    padding: 0;
    color: #3a322c;
    background: #fffdfa;
    box-shadow: 0 20px 60px rgba(85, 44, 32, 0.24);
  }
  dialog.sw-delete-dialog::backdrop { background: rgba(58, 50, 44, 0.38); }
  .sw-delete-dialog-inner { padding: 22px; }
  .sw-delete-dialog h2 { margin: 0 0 8px; font-size: 1.15rem; }
  .sw-delete-song-name { margin: 0 0 4px; font-weight: 700; word-break: break-word; }
  .sw-delete-targets { margin: 0 0 16px; color: #6f665c; font-size: 0.85rem; }
  .sw-delete-summary {
    margin: 0;
    padding: 14px 16px 14px 34px;
    border-left: 4px solid #c9502f;
    background: #fbe9e6;
    border-radius: 8px;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .sw-delete-warning { margin: 14px 0; color: #8f2e24; font-size: 0.85rem; font-weight: 700; }
  .sw-delete-actions { display: flex; justify-content: flex-end; gap: 8px; }
  button.sw-btn-danger {
    background: #a63d31;
    border-color: #a63d31;
    color: #fff;
    font-weight: 700;
  }
  button.sw-btn-danger:hover:not(:disabled) { background: #8f2e24; border-color: #8f2e24; }
  .sw-delete-error { min-height: 1.3em; margin: 12px 0 0; color: #c0392b; font-size: 0.82rem; }
  p.sw-empty { color: #b3a99c; font-size: 0.85rem; }

  footer.sw-footer {
    padding: 10px 24px 28px;
    color: #b3a99c;
    font-size: 0.75rem;
  }
</style>
</head>
<body>
<header class="sw-header">
  <h1 class="sw-title">Bunri</h1>
  <p class="sw-sub">音源から楽器別の練習パッケージを作る</p>
</header>

<main class="sw-main">
  <section class="sw-section">
    <h2 class="sw-h2">音源をアップロード</h2>
    <div id="sw-dropzone" class="sw-dropzone" tabindex="0" role="button"
         aria-label="音声ファイルをドラッグ&ドロップ、またはクリックして選択">
      <p>ここに音声ファイルをドラッグ&amp;ドロップ<br>またはクリックしてファイルを選択</p>
      <p class="sw-dropzone-sub">mp3 / wav / m4a / aac / flac / ogg / opus / mp4 / mov / webm(上限 500MB。動画は音声トラックを使います)</p>
    </div>
    <input id="sw-file-input" type="file" accept=".mp3,.wav,.m4a,.aac,.flac,.ogg,.opus,.mp4,.mov,.webm,audio/*,video/mp4,video/quicktime,video/webm" hidden>

    <div id="sw-confirm" class="sw-confirm" hidden>
      <div id="sw-confirm-filename" class="sw-confirm-filename"></div>
      <div class="sw-row">
        <label for="sw-title-input">曲名</label>
        <input id="sw-title-input" class="sw-title-input" type="text" maxlength="200">
      </div>
      <fieldset class="sw-targets">
        <legend>分離する楽器</legend>
        <div class="sw-target-options">
          <label class="sw-target-option"><input type="checkbox" name="targets" value="guitar"> ギター</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="bass"> ベース</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="drums"> ドラム</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="vocals"> ボーカル</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="piano"> ピアノ</label>
        </div>
      </fieldset>
      <div class="sw-row">
        <button type="button" id="sw-upload-btn" class="sw-btn sw-btn-primary">アップロードして分離開始</button>
        <button type="button" id="sw-cancel-btn" class="sw-btn">キャンセル</button>
      </div>
      <p id="sw-upload-error" class="sw-upload-error"></p>
    </div>
  </section>

  <section class="sw-section">
    <h2 id="sw-songs-heading" class="sw-h2" tabindex="-1">曲一覧</h2>
    <p id="sw-empty" class="sw-empty">まだ曲はありません。</p>
    <ul id="sw-job-list" class="sw-job-list"></ul>
  </section>
</main>

<dialog id="sw-delete-dialog" class="sw-delete-dialog" aria-labelledby="sw-delete-dialog-title">
  <div class="sw-delete-dialog-inner">
    <h2 id="sw-delete-dialog-title">この曲を削除しますか？</h2>
    <p id="sw-delete-song-name" class="sw-delete-song-name"></p>
    <p id="sw-delete-targets" class="sw-delete-targets"></p>
    <ul class="sw-delete-summary">
      <li>練習パッケージ</li>
      <li>この曲の全ジョブ履歴とログ</li>
      <li>ほかの曲と共有していないアップロード元とキャッシュ</li>
    </ul>
    <p class="sw-delete-warning">この操作は取り消せません。</p>
    <div class="sw-delete-actions">
      <button type="button" id="sw-delete-cancel" class="sw-btn">キャンセル</button>
      <button type="button" id="sw-delete-confirm" class="sw-btn sw-btn-danger">削除する</button>
    </div>
    <p id="sw-delete-error" class="sw-delete-error" role="alert"></p>
  </div>
</dialog>

<footer class="sw-footer">
  Bunri はローカル専用です(127.0.0.1 でのみ待ち受け)。
</footer>

<script>
(function () {
  "use strict";

  var API_JOBS = "/api/jobs";
  var API_SONGS = "/api/songs";
  var POLL_INTERVAL_MS = 2000;

  var dropzone = document.getElementById("sw-dropzone");
  var fileInput = document.getElementById("sw-file-input");
  var confirmPanel = document.getElementById("sw-confirm");
  var confirmFilename = document.getElementById("sw-confirm-filename");
  var titleInput = document.getElementById("sw-title-input");
  var uploadBtn = document.getElementById("sw-upload-btn");
  var cancelBtn = document.getElementById("sw-cancel-btn");
  var uploadError = document.getElementById("sw-upload-error");
  var targetInputs = Array.prototype.slice.call(
    document.querySelectorAll('input[name="targets"]')
  );
  var jobListEl = document.getElementById("sw-job-list");
  var emptyMsg = document.getElementById("sw-empty");
  var songsHeading = document.getElementById("sw-songs-heading");
  var deleteDialog = document.getElementById("sw-delete-dialog");
  var deleteSongName = document.getElementById("sw-delete-song-name");
  var deleteTargets = document.getElementById("sw-delete-targets");
  var deleteCancel = document.getElementById("sw-delete-cancel");
  var deleteConfirm = document.getElementById("sw-delete-confirm");
  var deleteError = document.getElementById("sw-delete-error");

  var pendingFile = null;
  var pollTimer = null;
  var songsCache = [];
  var songExpandedStates = Object.create(null);
  var deleteDialogSong = null;
  var deleteSubmitting = false;

  function stem(name) {
    var idx = name.lastIndexOf(".");
    return idx > 0 ? name.slice(0, idx) : name;
  }

  function showConfirm(file) {
    pendingFile = file;
    confirmFilename.textContent = file.name;
    titleInput.value = stem(file.name);
    uploadError.textContent = "";
    targetInputs.forEach(function (input) { input.checked = input.value === "guitar"; });
    confirmPanel.hidden = false;
    updateUploadEnabled();
  }

  function hideConfirm() {
    pendingFile = null;
    confirmPanel.hidden = true;
    fileInput.value = "";
  }

  dropzone.addEventListener("click", function () { fileInput.click(); });
  dropzone.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fileInput.click();
    }
  });
  fileInput.addEventListener("change", function () {
    if (fileInput.files && fileInput.files[0]) showConfirm(fileInput.files[0]);
  });

  ["dragenter", "dragover"].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) {
      e.preventDefault();
      dropzone.classList.add("is-dragover");
    });
  });
  ["dragleave", "drop"].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) {
      e.preventDefault();
      dropzone.classList.remove("is-dragover");
    });
  });
  dropzone.addEventListener("drop", function (e) {
    var files = e.dataTransfer && e.dataTransfer.files;
    if (files && files[0]) showConfirm(files[0]);
  });

  cancelBtn.addEventListener("click", hideConfirm);

  function selectedTargets() {
    return targetInputs.filter(function (input) { return input.checked; });
  }

  function updateUploadEnabled() {
    uploadBtn.disabled = !pendingFile || selectedTargets().length === 0;
  }

  targetInputs.forEach(function (input) {
    input.addEventListener("change", updateUploadEnabled);
  });

  uploadBtn.addEventListener("click", function () {
    if (!pendingFile) return;
    var targets = selectedTargets();
    if (targets.length === 0) {
      uploadError.textContent = "分離する楽器を1つ以上選択してください";
      updateUploadEnabled();
      return;
    }
    uploadBtn.disabled = true;
    uploadError.textContent = "";
    var fd = new FormData();
    fd.append("file", pendingFile);
    fd.append("title", titleInput.value || stem(pendingFile.name));
    targets.forEach(function (input) { fd.append("targets", input.value); });
    fetch(API_JOBS, { method: "POST", body: fd })
      .then(function (res) {
        if (!res.ok) {
          return res.json().catch(function () { return {}; }).then(function (body) {
            throw new Error(body.detail || ("アップロードに失敗しました (" + res.status + ")"));
          });
        }
        return res.json();
      })
      .then(function () {
        hideConfirm();
        return refreshSongs();
      })
      .catch(function (err) {
        uploadError.textContent = err.message || "アップロードに失敗しました";
      })
      .finally(function () {
        updateUploadEnabled();
      });
  });

  function fmtMMSS(totalSeconds) {
    var s = Math.max(0, Math.floor(totalSeconds || 0));
    var m = Math.floor(s / 60);
    var r = s % 60;
    return m + ":" + (r < 10 ? "0" : "") + r;
  }

  function badgeFor(job) {
    switch (job.status) {
      case "queued":
        return { text: "待機中", cls: "sw-badge-queued" };
      case "running":
        return { text: "処理中 (" + fmtMMSS(job.elapsed_seconds) + ")", cls: "sw-badge-running" };
      case "done":
        return { text: "完了", cls: "sw-badge-done" };
      case "error":
        return { text: "失敗", cls: "sw-badge-error" };
      default:
        return { text: job.status, cls: "" };
    }
  }

  function songHasActiveJobs(song) {
    return song.targets.some(function (job) {
      return job.status === "queued" || job.status === "running";
    });
  }

  function expandedFor(song) {
    if (!Object.prototype.hasOwnProperty.call(songExpandedStates, song.id)) {
      songExpandedStates[song.id] = songHasActiveJobs(song);
    }
    return songExpandedStates[song.id];
  }

  function deleteButtonFor(songId) {
    var cards = jobListEl.querySelectorAll("li.sw-job");
    for (var i = 0; i < cards.length; i += 1) {
      if (cards[i].dataset.songId === songId) {
        return cards[i].querySelector("button.sw-delete-song-btn");
      }
    }
    return null;
  }

  function openDeleteDialog(song) {
    if (deleteSubmitting) return;
    deleteDialogSong = song;
    deleteSongName.textContent = song.title;
    var labels = song.targets.map(function (job) { return job.target_label; });
    deleteTargets.textContent = labels.length + "楽器: " + labels.join("、");
    deleteError.textContent = "";
    deleteCancel.disabled = false;
    deleteConfirm.disabled = false;
    deleteConfirm.textContent = "削除する";
    deleteDialog.showModal();
  }

  function closeDeleteDialog(restoreFocus) {
    var songId = deleteDialogSong && deleteDialogSong.id;
    deleteDialog.close();
    deleteDialogSong = null;
    if (restoreFocus && songId) {
      var button = deleteButtonFor(songId);
      if (button) button.focus({ preventScroll: true });
    }
  }

  deleteCancel.addEventListener("click", function () {
    if (!deleteSubmitting) closeDeleteDialog(true);
  });
  deleteDialog.addEventListener("cancel", function (event) {
    event.preventDefault();
    if (!deleteSubmitting) closeDeleteDialog(true);
  });
  deleteConfirm.addEventListener("click", function () {
    if (deleteSubmitting || !deleteDialogSong) return;
    var song = deleteDialogSong;
    deleteSubmitting = true;
    deleteCancel.disabled = true;
    deleteConfirm.disabled = true;
    deleteConfirm.textContent = "削除中…";
    deleteError.textContent = "";
    fetch(API_SONGS + "/" + encodeURIComponent(song.id), { method: "DELETE" })
      .then(function (res) {
        if (!res.ok) {
          return res.json().catch(function () { return {}; }).then(function (body) {
            throw new Error(body.detail || ("削除に失敗しました (" + res.status + ")"));
          });
        }
        deleteDialog.close();
        deleteDialogSong = null;
        delete songExpandedStates[song.id];
        return refreshSongs().then(function () { songsHeading.focus(); });
      })
      .catch(function (err) {
        deleteSubmitting = false;
        deleteError.textContent = err.message || "削除に失敗しました";
        deleteCancel.disabled = false;
        deleteConfirm.disabled = false;
        deleteConfirm.textContent = "削除する";
      })
      .finally(function () { deleteSubmitting = false; });
  });

  function renderSongs(songs) {
    var focusedSongId = null;
    var activeElement = document.activeElement;
    if (activeElement && activeElement.matches("button.sw-job-toggle")) {
      var focusedCard = activeElement.closest("li.sw-job");
      if (focusedCard && jobListEl.contains(focusedCard)) {
        focusedSongId = focusedCard.dataset.songId;
      }
    }

    songsCache = songs;
    jobListEl.innerHTML = "";
    emptyMsg.hidden = songs.length !== 0;

    songs.forEach(function (song) {
      var li = document.createElement("li");
      li.className = "sw-job";
      li.dataset.songId = song.id;

      var expanded = expandedFor(song);
      var contentId = "sw-song-content-" + song.id;
      var head = document.createElement("button");
      head.type = "button";
      head.className = "sw-job-toggle";
      head.setAttribute("aria-expanded", String(expanded));
      head.setAttribute("aria-controls", contentId);

      var title = document.createElement("span");
      title.className = "sw-job-title";
      title.textContent = song.title;
      head.appendChild(title);

      var summary = document.createElement("span");
      summary.className = "sw-job-summary";
      song.targets.forEach(function (job) {
        var badge = badgeFor(job);
        var badgeEl = document.createElement("span");
        badgeEl.className = "sw-badge sw-summary-badge " + badge.cls;
        badgeEl.textContent = job.target_label;
        if (job.status === "done") {
          badgeEl.setAttribute("aria-label", job.target_label + " 完了");
        } else {
          badgeEl.textContent += " " + badge.text;
        }
        summary.appendChild(badgeEl);
      });
      head.appendChild(summary);

      var chevron = document.createElement("span");
      chevron.className = "sw-job-chevron";
      chevron.setAttribute("aria-hidden", "true");
      chevron.textContent = "▼";
      head.appendChild(chevron);
      li.appendChild(head);

      var content = document.createElement("div");
      content.className = "sw-job-content";
      content.id = contentId;
      content.hidden = !expanded;

      head.addEventListener("click", function () {
        var nextExpanded = head.getAttribute("aria-expanded") !== "true";
        songExpandedStates[song.id] = nextExpanded;
        head.setAttribute("aria-expanded", String(nextExpanded));
        content.hidden = !nextExpanded;
      });

      song.targets.forEach(function (job) {
        var row = document.createElement("div");
        row.className = "sw-target-row";
        row.dataset.target = job.target;
        var label = document.createElement("span");
        label.className = "sw-target-label";
        label.textContent = job.target_label;
        row.appendChild(label);
        var badge = badgeFor(job);
        var badgeEl = document.createElement("span");
        badgeEl.className = "sw-badge " + badge.cls;
        badgeEl.textContent = badge.text;
        row.appendChild(badgeEl);
        if (job.status === "done" && job.package_url) {
          var link = document.createElement("a");
          link.href = job.package_url;
          link.target = "_blank";
          link.rel = "noopener";
          link.className = "sw-open-link";
          link.textContent = "プレイヤーを開く";
          row.appendChild(link);
        }
        content.appendChild(row);
        if (job.status === "error" && job.error) {
          var details = document.createElement("details");
          details.className = "sw-error-details";
          var summary = document.createElement("summary");
          summary.textContent = "失敗の詳細(ログ末尾)";
          details.appendChild(summary);
          var pre = document.createElement("pre");
          pre.textContent = job.error;
          details.appendChild(pre);
          content.appendChild(details);
        }
      });

      var deleteArea = document.createElement("div");
      deleteArea.className = "sw-delete-area";
      var deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "sw-btn sw-delete-song-btn";
      deleteButton.textContent = "この曲を削除";
      deleteButton.disabled = songHasActiveJobs(song);
      if (deleteButton.disabled) {
        deleteButton.title = "待機中または処理中のジョブがある曲は削除できません";
      }
      deleteButton.addEventListener("click", function () { openDeleteDialog(song); });
      deleteArea.appendChild(deleteButton);
      content.appendChild(deleteArea);

      li.appendChild(content);

      jobListEl.appendChild(li);
    });

    if (focusedSongId !== null) {
      var replacementCard = Array.prototype.find.call(
        jobListEl.querySelectorAll("li.sw-job"),
        function (card) { return card.dataset.songId === focusedSongId; }
      );
      if (replacementCard) {
        replacementCard.querySelector("button.sw-job-toggle").focus({ preventScroll: true });
      }
    }
  }

  function hasActiveJobs(songs) {
    return songs.some(function (song) {
      return songHasActiveJobs(song);
    });
  }

  function schedulePoll(jobs) {
    if (pollTimer !== null) {
      clearTimeout(pollTimer);
      pollTimer = null;
    }
    if (hasActiveJobs(jobs)) {
      pollTimer = setTimeout(function () { refreshSongs(); }, POLL_INTERVAL_MS);
    }
  }

  function refreshSongs() {
    return fetch(API_SONGS)
      .then(function (res) { return res.json(); })
      .then(function (songs) {
        renderSongs(songs);
        schedulePoll(songs);
        return songs;
      })
      .catch(function () {
        // Transient failure (e.g. server restarting -- exactly the
        // running->queued recovery scenario): keep the last known list on
        // screen and RESCHEDULE ourselves. Without this the poll chain dies
        // on a single failed fetch and a finished job never shows its link.
        if (pollTimer !== null) clearTimeout(pollTimer);
        pollTimer = setTimeout(function () { refreshSongs(); }, POLL_INTERVAL_MS);
      });
  }

  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "visible") refreshSongs();
  });

  // Test/automation hook, same idea as the player's window.__player: exposes
  // read-only introspection so a headless test can assert on real state
  // (current job list, whether polling is active) instead of guessing from
  // timing.
  window.__bunriWeb = {
    getSongs: function () { return songsCache; },
    getJobs: function () {
      return songsCache.reduce(function (jobs, song) { return jobs.concat(song.targets); }, []);
    },
    isPolling: function () { return pollTimer !== null; },
    refresh: refreshSongs
  };

  refreshSongs();
})();
</script>
</body>
</html>

<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bunri</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    background: #faf6f0;
    color: #3a322c;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans",
      "Yu Gothic", Arial, sans-serif;
  }
  header.sw-header {
    padding: 20px 0;
    background: #fffdfa;
    border-bottom: 1px solid #f1e8da;
  }
  .sw-header-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }
  h1.sw-title {
    margin: 0 0 4px;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .sw-sub { margin: 0; color: #8a7f74; font-size: 0.85rem; }
  .sw-pocket-banner {
    display: inline-flex;
    margin-top: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #e3f3ef;
    color: #1f6f64;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .sw-pocket-banner[hidden] { display: none; }
  main.sw-main {
    padding: 22px 24px 40px;
    max-width: 760px;
    margin: 0 auto;
  }
  section.sw-section { margin-bottom: 28px; }
  h2.sw-h2 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #6f665c;
    margin: 0 0 12px;
  }
  .sw-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .sw-section-heading .sw-h2 { margin: 0; }
  .sw-pocket-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sw-pocket-controls[hidden] { display: none; }
  .sw-pocket-note { color: #8a7f74; font-size: 0.76rem; }
  .sw-pocket-summary {
    flex-basis: 100%;
    margin: 2px 0 0;
    color: #1f6f64;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .sw-pocket-summary[hidden] { display: none; }
  .sw-pocket-summary.is-error { color: #c0392b; }
  .sw-pocket-row { border-bottom: 1px solid #f1e8da; padding: 10px 0 12px; }
  .sw-pocket-row-main { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sw-pocket-message { margin: 6px 0 0; color: #8a7f74; font-size: 0.78rem; }
  .sw-remote-only { margin-top: 24px; }
  .sw-remote-only[hidden] { display: none; }
  .sw-remote-only-list { list-style: none; margin: 10px 0 0; padding: 0; }
  .sw-remote-only-item { display: flex; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid #f1e8da; }
  .sw-remote-only-id { color: #8a7f74; font-family: ui-monospace, monospace; font-size: 0.78rem; }

  .sw-dropzone {
    border: 2px dashed #e6d9c4;
    border-radius: 16px;
    padding: 34px 16px;
    text-align: center;
    color: #8a7f74;
    background: #ffffff;
    box-shadow: 0 2px 10px rgba(120, 90, 60, 0.06);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .sw-dropzone:hover { background: #fffaf3; border-color: #e2674e; box-shadow: 0 4px 14px rgba(226, 103, 78, 0.12); }
  .sw-dropzone.is-dragover {
    background: #fdece7;
    border-color: #e2674e;
    color: #3a322c;
  }
  .sw-dropzone p { margin: 0; font-size: 0.95rem; }
  .sw-dropzone .sw-dropzone-sub { margin-top: 6px; font-size: 0.78rem; color: #b3a99c; }

  .sw-confirm {
    margin-top: 16px;
    border: 1px solid #f1e8da;
    border-radius: 14px;
    padding: 16px 18px;
    background: #ffffff;
    box-shadow: 0 2px 10px rgba(120, 90, 60, 0.06);
  }
  .sw-confirm[hidden] { display: none; }
  .sw-confirm-filename {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 8px;
    word-break: break-all;
  }
  .sw-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .sw-row > label {
    min-width: 4.5em;
    color: #6f665c;
    font-size: 0.85rem;
    font-weight: 600;
  }
  input.sw-title-input {
    flex: 1 1 auto;
    min-width: 200px;
    font: inherit;
    font-size: 0.9rem;
    padding: 8px 12px;
    border: 1px solid #e6d9c4;
    border-radius: 10px;
  }
  fieldset.sw-targets {
    border: 0;
    padding: 0;
    margin: 0 0 12px;
  }
  fieldset.sw-targets legend {
    color: #6f665c;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 7px;
  }
  .sw-target-options { display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .sw-target-option { font-size: 0.85rem; white-space: nowrap; }
  button.sw-btn {
    font: inherit;
    font-size: 0.9rem;
    padding: 8px 18px;
    border: 1px solid #e6d9c4;
    background: #ffffff;
    border-radius: 999px;
    cursor: pointer;
    color: #3a322c;
  }
  button.sw-btn:hover:not(:disabled) { background: #fff7ee; border-color: #e2674e; }
  button.sw-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  button.sw-btn-primary {
    background: #e2674e;
    border-color: #e2674e;
    color: #fffaf6;
    font-weight: 700;
  }
  button.sw-btn-primary:hover:not(:disabled) { background: #d1553d; border-color: #d1553d; }
  .sw-upload-error {
    color: #c0392b;
    font-size: 0.82rem;
    margin-top: 8px;
  }

  ul.sw-job-list { list-style: none; margin: 0; padding: 0; }
  li.sw-job {
    border: 1px solid #f1e8da;
    border-radius: 14px;
    margin-bottom: 10px;
    background: #ffffff;
    box-shadow: 0 2px 10px rgba(120, 90, 60, 0.05);
    overflow: hidden;
  }
  button.sw-job-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
  }
  button.sw-job-toggle:hover { background: #fffaf3; }
  button.sw-job-toggle:focus-visible {
    outline: 2px solid #e2674e;
    outline-offset: -2px;
  }
  .sw-job-title {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .sw-job-summary {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sw-job-summary::-webkit-scrollbar { display: none; }
  button.sw-job-toggle[aria-expanded="true"] .sw-job-summary { display: none; }
  .sw-job-chevron {
    margin-left: auto;
    color: #8a7f74;
    font-size: 0.8rem;
  }
  button.sw-job-toggle[aria-expanded="true"] .sw-job-chevron { transform: rotate(180deg); }
  .sw-job-content { padding: 0 16px 14px; }
  .sw-job-content[hidden] { display: none; }
  .sw-target-block { min-width: 0; }
  .sw-target-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 10px;
  }
  .sw-target-label { min-width: 5em; font-size: 0.85rem; font-weight: 600; }
  .sw-badge {
    font-size: 0.78rem;
    padding: 3px 12px;
    border-radius: 999px;
    background: #f1ece3;
    color: #8a7f74;
    white-space: nowrap;
    font-weight: 600;
  }
  .sw-badge-queued { background: #f1ece3; color: #8a7f74; }
  .sw-badge-running { background: #fdeee8; color: #c9502f; }
  .sw-badge-done { background: #e3f3ef; color: #1f6f64; }
  .sw-badge-error { background: #fbe9e6; color: #c0392b; }
  .sw-summary-badge { padding: 2px 8px; font-size: 0.72rem; }
  a.sw-open-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #2f8f83;
    text-decoration: none;
    background: #ffffff;
    border: 1.5px solid #2f8f83;
    border-radius: 999px;
    padding: 4px 14px;
  }
  a.sw-open-link:hover { background: #e9f5f2; text-decoration: none; }
  .sw-play-icon {
    width: 0.8em;
    height: 0.8em;
    flex: none;
  }
  button.sw-download-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 13px;
    border: 1px solid #e6d9c4;
    border-radius: 999px;
    background: #ffffff;
    color: #3a322c;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  button.sw-download-toggle:hover {
    border-color: #e2674e;
    background: #fff7ee;
  }
  button.sw-download-toggle[aria-expanded="true"] { background: #fff7ee; }
  .sw-download-caret {
    display: inline-block;
    transition: transform 0.15s;
  }
  button.sw-download-toggle[aria-expanded="true"] .sw-download-caret {
    transform: rotate(180deg);
  }
  .sw-downloads {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
    padding: 8px 0 2px 5em;
  }
  .sw-downloads[hidden] { display: none; }
  .sw-download-group {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid #e6d9c4;
    border-radius: 999px;
    overflow: hidden;
    background: #ffffff;
  }
  .sw-download-label {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    background: #ece0cc;
    color: #635a4f;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .sw-download-icon {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }
  a.sw-download-link {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    border-left: 1px solid #efe6d8;
    color: #2f8f83;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }
  a.sw-download-link:hover { background: #e9f5f2; }
  @media (max-width: 480px) {
    .sw-downloads { padding-left: 0; }
  }
  details.sw-error-details {
    margin-top: 8px;
    font-size: 0.8rem;
    color: #8a7f74;
  }
  details.sw-error-details summary {
    cursor: pointer;
    color: #c0392b;
  }
  details.sw-error-details pre {
    white-space: pre-wrap;
    word-break: break-all;
    background: #fbf8f3;
    border: 1px solid #f1e8da;
    border-radius: 10px;
    padding: 10px 12px;
    margin: 8px 0 0;
    font-size: 0.75rem;
  }
  .sw-delete-area {
    display: flex;
    justify-content: flex-end;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #f1e8da;
  }
  button.sw-delete-song-btn {
    color: #a63d31;
    border-color: #e8b8af;
    background: #fffafa;
  }
  button.sw-delete-song-btn:hover:not(:disabled) {
    color: #8f2e24;
    border-color: #c9502f;
    background: #fbe9e6;
  }
  dialog.sw-delete-dialog {
    width: min(480px, calc(100% - 32px));
    border: 1px solid #e8b8af;
    border-radius: 18px;
    padding: 0;
    color: #3a322c;
    background: #fffdfa;
    box-shadow: 0 20px 60px rgba(85, 44, 32, 0.24);
  }
  dialog.sw-delete-dialog::backdrop { background: rgba(58, 50, 44, 0.38); }
  .sw-delete-dialog-inner { padding: 22px; }
  .sw-delete-dialog h2 { margin: 0 0 8px; font-size: 1.15rem; }
  .sw-delete-song-name { margin: 0 0 4px; font-weight: 700; word-break: break-word; }
  .sw-delete-targets { margin: 0 0 16px; color: #6f665c; font-size: 0.85rem; }
  .sw-delete-summary {
    margin: 0;
    padding: 14px 16px 14px 34px;
    border-left: 4px solid #c9502f;
    background: #fbe9e6;
    border-radius: 8px;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .sw-delete-warning { margin: 14px 0; color: #8f2e24; font-size: 0.85rem; font-weight: 700; }
  .sw-delete-actions { display: flex; justify-content: flex-end; gap: 8px; }
  button.sw-btn-danger {
    background: #a63d31;
    border-color: #a63d31;
    color: #fff;
    font-weight: 700;
  }
  button.sw-btn-danger:hover:not(:disabled) { background: #8f2e24; border-color: #8f2e24; }
  .sw-delete-error { min-height: 1.3em; margin: 12px 0 0; color: #c0392b; font-size: 0.82rem; }
  p.sw-empty { color: #b3a99c; font-size: 0.85rem; }

  footer.sw-footer {
    padding: 10px 24px 28px;
    color: #b3a99c;
    font-size: 0.75rem;
  }
</style>
</head>
<body>
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    <symbol id="sw-download-icon" viewBox="0 0 16 16">
      <path d="M8 1.5v8m0 0L4.8 6.3M8 9.5l3.2-3.2M2.5 12v1.2c0 .7.6 1.3 1.3 1.3h8.4c.7 0 1.3-.6 1.3-1.3V12"
            fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <symbol id="sw-play-icon" viewBox="0 0 16 16">
      <path d="M4 2.5v11l9-5.5z" fill="currentColor"/>
    </symbol>
  </defs>
</svg>
<header class="sw-header">
  <div class="sw-header-inner">
    <h1 class="sw-title">Bunri</h1>
    <p class="sw-sub">音源から楽器別の練習パッケージを作る</p>
    <div id="sw-pocket-banner" class="sw-pocket-banner" hidden>Bunri Pocket 連携中</div>
  </div>
</header>

<main class="sw-main">
  <section class="sw-section">
    <h2 class="sw-h2">音源をアップロード</h2>
    <div id="sw-dropzone" class="sw-dropzone" tabindex="0" role="button"
         aria-label="音声ファイルをドラッグ&ドロップ、またはクリックして選択">
      <p>ここに音声ファイルをドラッグ&amp;ドロップ<br>またはクリックしてファイルを選択</p>
      <p class="sw-dropzone-sub">mp3 / wav / m4a / aac / flac / ogg / opus / mp4 / mov / webm(上限 500MB。動画は音声トラックを使います)</p>
    </div>
    <input id="sw-file-input" type="file" accept=".mp3,.wav,.m4a,.aac,.flac,.ogg,.opus,.mp4,.mov,.webm,audio/*,video/mp4,video/quicktime,video/webm" hidden>

    <div id="sw-confirm" class="sw-confirm" hidden>
      <div id="sw-confirm-filename" class="sw-confirm-filename"></div>
      <div class="sw-row">
        <label for="sw-title-input">曲名</label>
        <input id="sw-title-input" class="sw-title-input" type="text" maxlength="200">
      </div>
      <fieldset class="sw-targets">
        <legend>分離する楽器</legend>
        <div class="sw-target-options">
          <label class="sw-target-option"><input type="checkbox" name="targets" value="guitar"> ギター</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="bass"> ベース</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="drums"> ドラム</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="vocals"> ボーカル</label>
          <label class="sw-target-option"><input type="checkbox" name="targets" value="piano"> ピアノ</label>
        </div>
      </fieldset>
      <div class="sw-row">
        <button type="button" id="sw-upload-btn" class="sw-btn sw-btn-primary">アップロードして分離開始</button>
        <button type="button" id="sw-cancel-btn" class="sw-btn">キャンセル</button>
      </div>
      <p id="sw-upload-error" class="sw-upload-error"></p>
    </div>
  </section>

  <section class="sw-section">
    <div class="sw-section-heading">
      <h2 id="sw-songs-heading" class="sw-h2" tabindex="-1">曲一覧</h2>
      <div id="sw-pocket-controls" class="sw-pocket-controls" hidden>
        <button type="button" id="sw-pocket-all" class="sw-btn sw-btn-primary">全曲アップロード</button>
        <button type="button" id="sw-pocket-refresh" class="sw-btn">状態を再読込</button>
        <span id="sw-pocket-count" class="sw-pocket-note"></span>
        <p id="sw-pocket-summary" class="sw-pocket-summary" role="status" aria-live="polite" hidden></p>
      </div>
    </div>
    <p id="sw-empty" class="sw-empty">まだ曲はありません。</p>
    <ul id="sw-job-list" class="sw-job-list"></ul>
    <p id="sw-remote-only-error" class="sw-upload-error" role="status" aria-live="polite" hidden></p>
    <section id="sw-remote-only" class="sw-remote-only" aria-labelledby="sw-remote-only-title" hidden>
      <h3 id="sw-remote-only-title">棚にのみある曲</h3>
      <p class="sw-pocket-note">読み取り専用です。削除するには CLI の --select または --song-id を使ってください。</p>
      <ul id="sw-remote-only-list" class="sw-remote-only-list"></ul>
    </section>
  </section>
</main>

<dialog id="sw-delete-dialog" class="sw-delete-dialog" aria-labelledby="sw-delete-dialog-title">
  <div class="sw-delete-dialog-inner">
    <h2 id="sw-delete-dialog-title">この曲を削除しますか？</h2>
    <p id="sw-delete-song-name" class="sw-delete-song-name"></p>
    <p id="sw-delete-targets" class="sw-delete-targets"></p>
    <ul class="sw-delete-summary">
      <li>練習パッケージ</li>
      <li>この曲の全ジョブ履歴とログ</li>
      <li>ほかの曲と共有していないアップロード元とキャッシュ</li>
      <li id="sw-delete-pocket-summary" hidden>棚の library、manifest、media</li>
    </ul>
    <label id="sw-delete-pocket-option" hidden>
      <input type="checkbox" id="sw-delete-pocket"> Bunri Pocket の棚からも削除する
    </label>
    <p id="sw-delete-pocket-note" class="sw-pocket-note" hidden>棚削除の確認後にローカルデータを削除します。</p>
    <p class="sw-delete-warning">この操作は取り消せません。</p>
    <div class="sw-delete-actions">
      <button type="button" id="sw-delete-cancel" class="sw-btn">キャンセル</button>
      <button type="button" id="sw-delete-confirm" class="sw-btn sw-btn-danger">削除する</button>
    </div>
    <p id="sw-delete-error" class="sw-delete-error" role="alert"></p>
  </div>
</dialog>

<footer class="sw-footer">
  Bunri はローカル専用です(127.0.0.1 でのみ待ち受け)。
</footer>

<script>
(function () {
  "use strict";

  var API_JOBS = "/api/jobs";
  var API_SONGS = "/api/songs";
  var API_POCKET_STATUS = "/api/pocket/status";
  var API_POCKET_JOB = "/api/pocket/job";
  var API_POCKET_SYNC = "/api/pocket/sync";
  var POLL_INTERVAL_MS = 2000;

  var dropzone = document.getElementById("sw-dropzone");
  var fileInput = document.getElementById("sw-file-input");
  var confirmPanel = document.getElementById("sw-confirm");
  var confirmFilename = document.getElementById("sw-confirm-filename");
  var titleInput = document.getElementById("sw-title-input");
  var uploadBtn = document.getElementById("sw-upload-btn");
  var cancelBtn = document.getElementById("sw-cancel-btn");
  var uploadError = document.getElementById("sw-upload-error");
  var targetInputs = Array.prototype.slice.call(
    document.querySelectorAll('input[name="targets"]')
  );
  var jobListEl = document.getElementById("sw-job-list");
  var emptyMsg = document.getElementById("sw-empty");
  var songsHeading = document.getElementById("sw-songs-heading");
  var deleteDialog = document.getElementById("sw-delete-dialog");
  var deleteSongName = document.getElementById("sw-delete-song-name");
  var deleteTargets = document.getElementById("sw-delete-targets");
  var deleteCancel = document.getElementById("sw-delete-cancel");
  var deleteConfirm = document.getElementById("sw-delete-confirm");
  var deleteError = document.getElementById("sw-delete-error");
  var deletePocketOption = document.getElementById("sw-delete-pocket-option");
  var deletePocket = document.getElementById("sw-delete-pocket");
  var deletePocketSummary = document.getElementById("sw-delete-pocket-summary");
  var deletePocketNote = document.getElementById("sw-delete-pocket-note");
  var pocketBanner = document.getElementById("sw-pocket-banner");
  var pocketControls = document.getElementById("sw-pocket-controls");
  var pocketAll = document.getElementById("sw-pocket-all");
  var pocketRefresh = document.getElementById("sw-pocket-refresh");
  var pocketCount = document.getElementById("sw-pocket-count");
  var pocketSummary = document.getElementById("sw-pocket-summary");
  var remoteOnlyError = document.getElementById("sw-remote-only-error");
  var remoteOnlySection = document.getElementById("sw-remote-only");
  var remoteOnlyList = document.getElementById("sw-remote-only-list");
  var remoteOnlyTracks = [];

  var pendingFile = null;
  var pollTimer = null;
  var songsCache = [];
  var songExpandedStates = Object.create(null);
  var downloadExpandedStates = Object.create(null);
  var deleteDialogSong = null;
  var deleteSubmitting = false;
  var pocketConnected = false;
  var pocketChecking = false;
  var pocketStatuses = Object.create(null);
  var activePocketJobId = null;
  var pocketJobGeneration = 0;
  var pocketStatusGeneration = 0;
  // The package tally comes from the remote status call and the batch progress
  // from the job poll; they share one line, so each keeps its own text and the
  // progress wins whenever a batch is in flight.
  var pocketCountText = "";
  var pocketProgressText = "";

  function stem(name) {
    var idx = name.lastIndexOf(".");
    return idx > 0 ? name.slice(0, idx) : name;
  }

  function showConfirm(file) {
    pendingFile = file;
    confirmFilename.textContent = file.name;
    titleInput.value = stem(file.name);
    uploadError.textContent = "";
    targetInputs.forEach(function (input) { input.checked = input.value === "guitar"; });
    confirmPanel.hidden = false;
    updateUploadEnabled();
  }

  function hideConfirm() {
    pendingFile = null;
    confirmPanel.hidden = true;
    fileInput.value = "";
  }

  dropzone.addEventListener("click", function () { fileInput.click(); });
  dropzone.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fileInput.click();
    }
  });
  fileInput.addEventListener("change", function () {
    if (fileInput.files && fileInput.files[0]) showConfirm(fileInput.files[0]);
  });

  ["dragenter", "dragover"].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) {
      e.preventDefault();
      dropzone.classList.add("is-dragover");
    });
  });
  ["dragleave", "drop"].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) {
      e.preventDefault();
      dropzone.classList.remove("is-dragover");
    });
  });
  dropzone.addEventListener("drop", function (e) {
    var files = e.dataTransfer && e.dataTransfer.files;
    if (files && files[0]) showConfirm(files[0]);
  });

  cancelBtn.addEventListener("click", hideConfirm);

  function selectedTargets() {
    return targetInputs.filter(function (input) { return input.checked; });
  }

  function updateUploadEnabled() {
    uploadBtn.disabled = !pendingFile || selectedTargets().length === 0;
  }

  targetInputs.forEach(function (input) {
    input.addEventListener("change", updateUploadEnabled);
  });

  uploadBtn.addEventListener("click", function () {
    if (!pendingFile) return;
    var targets = selectedTargets();
    if (targets.length === 0) {
      uploadError.textContent = "分離する楽器を1つ以上選択してください";
      updateUploadEnabled();
      return;
    }
    uploadBtn.disabled = true;
    uploadError.textContent = "";
    var fd = new FormData();
    fd.append("file", pendingFile);
    fd.append("title", titleInput.value || stem(pendingFile.name));
    targets.forEach(function (input) { fd.append("targets", input.value); });
    fetch(API_JOBS, { method: "POST", body: fd })
      .then(function (res) {
        if (!res.ok) {
          return res.json().catch(function () { return {}; }).then(function (body) {
            if (res.status === 409) {
              throw new Error("この曲は棚から削除中です。完了後に再度お試しください。");
            }
            throw new Error(body.detail || ("アップロードに失敗しました (" + res.status + ")"));
          });
        }
        return res.json();
      })
      .then(function () {
        hideConfirm();
        return refreshSongs();
      })
      .catch(function (err) {
        uploadError.textContent = err.message || "アップロードに失敗しました";
      })
      .finally(function () {
        updateUploadEnabled();
      });
  });

  function fmtMMSS(totalSeconds) {
    var s = Math.max(0, Math.floor(totalSeconds || 0));
    var m = Math.floor(s / 60);
    var r = s % 60;
    return m + ":" + (r < 10 ? "0" : "") + r;
  }

  function badgeFor(job) {
    switch (job.status) {
      case "queued":
        return { text: "待機中", cls: "sw-badge-queued" };
      case "running":
        return { text: "処理中 (" + fmtMMSS(job.elapsed_seconds) + ")", cls: "sw-badge-running" };
      case "done":
        return { text: "完了", cls: "sw-badge-done" };
      case "error":
        return { text: "失敗", cls: "sw-badge-error" };
      default:
        return { text: job.status, cls: "" };
    }
  }

  function songHasActiveJobs(song) {
    return song.targets.some(function (job) {
      return job.status === "queued" || job.status === "running";
    }) || Boolean(song.pocket_job && (
      song.pocket_job.status === "queued" || song.pocket_job.status === "running"
    ));
  }

  function hasActivePocketJobs(songs) {
    return songs.some(function (song) {
      return song.pocket_job && (
        song.pocket_job.status === "queued" || song.pocket_job.status === "running"
      );
    });
  }

  function hasActiveSeparationJobs(songs) {
    return songs.some(function (song) {
      return song.targets.some(function (job) {
        return job.status === "queued" || job.status === "running";
      });
    });
  }

  function pocketBadge(status, job) {
    if (job && (
      job.status === "queued" || job.status === "running" || job.status === "error"
    )) return badgeFor(job);
    if (pocketChecking) return { text: "確認中", cls: "sw-badge-queued" };
    if (!status) return { text: "確認できません", cls: "sw-badge-error" };
    switch (status.state) {
      case "synced": return { text: "棚にある", cls: "sw-badge-done" };
      case "not_synced": return { text: "未同期", cls: "sw-badge-queued" };
      case "different": return { text: "差分あり", cls: "sw-badge-running" };
      case "legacy": return { text: "再生成が必要", cls: "sw-badge-error" };
      default: return { text: "確認できません", cls: "sw-badge-error" };
    }
  }

  function postPocket(url) {
    return fetch(url, { method: "POST" }).then(function (res) {
      if (!res.ok) {
        return res.json().catch(function () { return {}; }).then(function (body) {
          throw new Error(body.detail || ("アップロードを開始できません (" + res.status + ")"));
        });
      }
      return res.json();
    }).then(function (body) {
      clearPocketSummary();
      activePocketJobId = body.job_id;
      return refreshSongs();
    });
  }

  function clearPocketSummary() {
    pocketSummary.hidden = true;
    pocketSummary.textContent = "";
    pocketSummary.classList.remove("is-error");
  }

  function renderPocketCount() {
    pocketCount.textContent = pocketProgressText || pocketCountText;
  }

  function setPocketConnected(connected) {
    pocketConnected = connected === true;
    pocketBanner.hidden = !pocketConnected;
    pocketControls.hidden = !pocketConnected;
  }

  function renderPocketProgress(job) {
    if (job && job.kind === "pocket_all" && job.progress
      && (job.status === "queued" || job.status === "running")) {
      pocketProgressText = "全曲アップロード: " + job.progress.completed + "/" + job.progress.total
        + (job.progress.current ? "（" + job.progress.current + "）" : "");
    } else {
      pocketProgressText = "";
    }
    renderPocketCount();
  }

  function pocketJobCount(job, name) {
    if (job.result && typeof job.result[name] === "number") return job.result[name];
    if (job.result && typeof job.result[name + "_count"] === "number") return job.result[name + "_count"];
    if (job.progress && typeof job.progress[name + "_count"] === "number") return job.progress[name + "_count"];
    if (job.progress && Array.isArray(job.progress[name])) return job.progress[name].length;
    if (job.progress && typeof job.progress[name] === "number") return job.progress[name];
    return 0;
  }

  function renderPocketSummary(job) {
    if (job.kind !== "pocket_all" || (job.status !== "done" && job.status !== "error")) return;
    var completed = pocketJobCount(job, "completed");
    var failed = pocketJobCount(job, "failed");
    var pending = pocketJobCount(job, "pending");
    var legacy = pocketJobCount(job, "legacy");
    var total = pocketJobCount(job, "total");
    var hasCounts = total > 0 || completed > 0 || failed > 0 || pending > 0 || legacy > 0;
    var legacyText = legacy ? "（再生成が必要 " + legacy + "件）" : "";
    if (job.status === "done") {
      pocketSummary.textContent = "全曲アップロード完了: " + completed + "件" + legacyText;
      pocketSummary.classList.remove("is-error");
    } else {
      var error = job.error || "Pocket の同期に失敗しました。";
      pocketSummary.textContent = "全曲アップロード失敗: " + error
        + (hasCounts
          ? "（完了 " + completed + "件 / 失敗 " + failed + "件 / 未実行 " + pending + "件）"
          : "")
        + legacyText;
      pocketSummary.classList.add("is-error");
    }
    pocketSummary.hidden = false;
  }

  function expandedFor(song) {
    if (!Object.prototype.hasOwnProperty.call(songExpandedStates, song.id)) {
      songExpandedStates[song.id] = songHasActiveJobs(song);
    }
    return songExpandedStates[song.id];
  }

  function deleteButtonFor(songId) {
    var cards = jobListEl.querySelectorAll("li.sw-job");
    for (var i = 0; i < cards.length; i += 1) {
      if (cards[i].dataset.songId === songId) {
        return cards[i].querySelector("button.sw-delete-song-btn");
      }
    }
    return null;
  }

  function openDeleteDialog(song) {
    if (deleteSubmitting) return;
    deleteDialogSong = song;
    deleteSongName.textContent = song.title;
    var labels = song.targets.map(function (job) { return job.target_label; });
    deleteTargets.textContent = labels.length + "楽器: " + labels.join("、");
    deleteError.textContent = "";
    var pocketStatus = pocketStatuses[song.id];
    deletePocket.checked = false;
    deletePocketOption.hidden = !(pocketConnected && pocketStatus && pocketStatus.can_delete);
    deletePocketSummary.hidden = true;
    deletePocketNote.hidden = true;
    deleteCancel.disabled = false;
    deleteConfirm.disabled = false;
    deleteConfirm.textContent = "削除する";
    deleteDialog.showModal();
  }

  function closeDeleteDialog(restoreFocus) {
    var songId = deleteDialogSong && deleteDialogSong.id;
    deleteDialog.close();
    deleteDialogSong = null;
    if (restoreFocus && songId) {
      var button = deleteButtonFor(songId);
      if (button) button.focus({ preventScroll: true });
    }
  }

  deleteCancel.addEventListener("click", function () {
    if (!deleteSubmitting) closeDeleteDialog(true);
  });
  deleteDialog.addEventListener("cancel", function (event) {
    event.preventDefault();
    if (!deleteSubmitting) closeDeleteDialog(true);
  });
  deletePocket.addEventListener("change", function () {
    deletePocketSummary.hidden = !deletePocket.checked;
    deletePocketNote.hidden = !deletePocket.checked;
  });
  deleteConfirm.addEventListener("click", function () {
    if (deleteSubmitting || !deleteDialogSong) return;
    var song = deleteDialogSong;
    deleteSubmitting = true;
    deleteCancel.disabled = true;
    deleteConfirm.disabled = true;
    deleteConfirm.textContent = "削除中…";
    deleteError.textContent = "";
    var removeFromPocket = deletePocket.checked;
    var deleteUrl = API_SONGS + "/" + encodeURIComponent(song.id)
      + (removeFromPocket ? "?pocket=true" : "");
    fetch(deleteUrl, { method: "DELETE" })
      .then(function (res) {
        if (!res.ok) {
          return res.json().catch(function () { return {}; }).then(function (body) {
            throw new Error(body.detail || ("削除に失敗しました (" + res.status + ")"));
          });
        }
        return res.status === 202 ? res.json() : null;
      })
      .then(function (body) {
        deleteDialog.close();
        deleteDialogSong = null;
        if (body && body.job_id) {
          activePocketJobId = body.job_id;
          return refreshSongs();
        }
        delete songExpandedStates[song.id];
        return refreshSongs().then(function () {
          songsHeading.focus();
          if (pocketConnected) return refreshPocketStatus();
        });
      })
      .catch(function (err) {
        deleteSubmitting = false;
        deleteError.textContent = err.message || "削除に失敗しました";
        deleteCancel.disabled = false;
        deleteConfirm.disabled = false;
        deleteConfirm.textContent = "削除する";
      })
      .finally(function () { deleteSubmitting = false; });
  });

  function renderSongs(songs) {
    var focusedSongId = null;
    var focusedDownloadJobId = null;
    var activeElement = document.activeElement;
    if (activeElement && activeElement.matches("button.sw-job-toggle")) {
      var focusedCard = activeElement.closest("li.sw-job");
      if (focusedCard && jobListEl.contains(focusedCard)) {
        focusedSongId = focusedCard.dataset.songId;
      }
    } else if (activeElement && activeElement.matches("button.sw-download-toggle")) {
      if (jobListEl.contains(activeElement)) {
        focusedDownloadJobId = activeElement.dataset.jobId;
      }
    }

    songsCache = songs;
    pocketAll.disabled = pocketChecking || hasActivePocketJobs(songs) || activePocketJobId !== null;
    updateUploadEnabled();
    jobListEl.innerHTML = "";
    emptyMsg.hidden = songs.length !== 0;

    songs.forEach(function (song) {
      var li = document.createElement("li");
      li.className = "sw-job";
      li.dataset.songId = song.id;

      var expanded = expandedFor(song);
      var contentId = "sw-song-content-" + song.id;
      var head = document.createElement("button");
      head.type = "button";
      head.className = "sw-job-toggle";
      head.setAttribute("aria-expanded", String(expanded));
      head.setAttribute("aria-controls", contentId);

      var title = document.createElement("span");
      title.className = "sw-job-title";
      title.textContent = song.title;
      head.appendChild(title);

      var summary = document.createElement("span");
      summary.className = "sw-job-summary";
      song.targets.forEach(function (job) {
        var badge = badgeFor(job);
        var badgeEl = document.createElement("span");
        badgeEl.className = "sw-badge sw-summary-badge " + badge.cls;
        badgeEl.textContent = job.target_label;
        if (job.status === "done") {
          badgeEl.setAttribute("aria-label", job.target_label + " 完了");
        } else {
          badgeEl.textContent += " " + badge.text;
        }
        summary.appendChild(badgeEl);
      });
      head.appendChild(summary);

      var chevron = document.createElement("span");
      chevron.className = "sw-job-chevron";
      chevron.setAttribute("aria-hidden", "true");
      chevron.textContent = "▼";
      head.appendChild(chevron);
      li.appendChild(head);

      var content = document.createElement("div");
      content.className = "sw-job-content";
      content.id = contentId;
      content.hidden = !expanded;

      if (pocketConnected) {
        var pocketStatus = pocketStatuses[song.id];
        var pocketRow = document.createElement("div");
        pocketRow.className = "sw-pocket-row";
        var pocketMain = document.createElement("div");
        pocketMain.className = "sw-pocket-row-main";
        var pocketState = pocketBadge(pocketStatus, song.pocket_job);
        if (song.pocket_job && song.pocket_job.kind === "pocket_delete"
          && (song.pocket_job.status === "queued" || song.pocket_job.status === "running")) {
          pocketState = { text: "棚から削除中", cls: "sw-badge-running" };
        }
        var pocketBadgeEl = document.createElement("span");
        pocketBadgeEl.className = "sw-badge " + pocketState.cls;
        pocketBadgeEl.textContent = pocketState.text;
        pocketMain.appendChild(pocketBadgeEl);
        var pocketButton = document.createElement("button");
        pocketButton.type = "button";
        pocketButton.className = "sw-btn";
        pocketButton.textContent = "⬆ アップロード";
        pocketButton.disabled = pocketChecking || activePocketJobId !== null
          || hasActivePocketJobs(songs) || !pocketStatus || !pocketStatus.can_sync;
        if (pocketStatus && pocketStatus.song_id) {
          pocketButton.addEventListener("click", function () {
            pocketButton.disabled = true;
            postPocket(API_POCKET_SYNC + "/" + encodeURIComponent(pocketStatus.song_id))
              .catch(function (err) {
                window.alert(err.message || "アップロードを開始できません");
                renderSongs(songsCache);
              });
          });
        }
        pocketMain.appendChild(pocketButton);
        pocketRow.appendChild(pocketMain);
        var pocketMessageText = song.pocket_job && song.pocket_job.status === "error"
          ? song.pocket_job.error
          : pocketStatus && pocketStatus.message;
        if (pocketMessageText) {
          var pocketMessage = document.createElement("p");
          pocketMessage.className = "sw-pocket-message";
          pocketMessage.setAttribute("role", "status");
          pocketMessage.setAttribute("aria-live", "polite");
          pocketMessage.textContent = pocketMessageText;
          pocketRow.appendChild(pocketMessage);
        }
        content.appendChild(pocketRow);
      }

      head.addEventListener("click", function () {
        var nextExpanded = head.getAttribute("aria-expanded") !== "true";
        songExpandedStates[song.id] = nextExpanded;
        head.setAttribute("aria-expanded", String(nextExpanded));
        content.hidden = !nextExpanded;
      });

      song.targets.forEach(function (job) {
        var targetBlock = document.createElement("div");
        targetBlock.className = "sw-target-block";
        targetBlock.dataset.target = job.target;
        var row = document.createElement("div");
        row.className = "sw-target-row";
        row.dataset.target = job.target;
        var label = document.createElement("span");
        label.className = "sw-target-label";
        label.textContent = job.target_label;
        row.appendChild(label);
        var badge = badgeFor(job);
        var badgeEl = document.createElement("span");
        badgeEl.className = "sw-badge " + badge.cls;
        badgeEl.textContent = badge.text;
        row.appendChild(badgeEl);
        if (job.status === "done" && job.package_url) {
          var link = document.createElement("a");
          link.href = job.package_url;
          link.target = "_blank";
          link.rel = "noopener";
          link.className = "sw-open-link";
          var playIcon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          playIcon.classList.add("sw-play-icon");
          playIcon.setAttribute("aria-hidden", "true");
          var playIconUse = document.createElementNS("http://www.w3.org/2000/svg", "use");
          playIconUse.setAttribute("href", "#sw-play-icon");
          playIcon.appendChild(playIconUse);
          link.appendChild(playIcon);
          link.appendChild(document.createTextNode("プレイヤーを開く"));
          row.appendChild(link);
        }
        if (job.status === "done" && Array.isArray(job.downloads) && job.downloads.length) {
          var downloadsExpanded = downloadExpandedStates[job.id] === true;
          var downloadsId = "sw-downloads-" + job.id;
          var downloadToggle = document.createElement("button");
          downloadToggle.type = "button";
          downloadToggle.className = "sw-download-toggle";
          downloadToggle.dataset.jobId = job.id;
          downloadToggle.setAttribute("aria-expanded", String(downloadsExpanded));
          downloadToggle.setAttribute("aria-controls", downloadsId);
          var downloadIcon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          downloadIcon.classList.add("sw-download-icon");
          downloadIcon.setAttribute("aria-hidden", "true");
          var downloadIconUse = document.createElementNS("http://www.w3.org/2000/svg", "use");
          downloadIconUse.setAttribute("href", "#sw-download-icon");
          downloadIcon.appendChild(downloadIconUse);
          downloadToggle.appendChild(downloadIcon);
          downloadToggle.appendChild(document.createTextNode("ダウンロード"));
          var downloadCaret = document.createElement("span");
          downloadCaret.className = "sw-download-caret";
          downloadCaret.setAttribute("aria-hidden", "true");
          downloadCaret.textContent = "▼";
          downloadToggle.appendChild(downloadCaret);
          row.appendChild(downloadToggle);
          targetBlock.appendChild(row);
          var downloads = document.createElement("div");
          downloads.className = "sw-downloads";
          downloads.id = downloadsId;
          downloads.hidden = !downloadsExpanded;
          job.downloads.forEach(function (track) {
            var downloadGroup = document.createElement("div");
            downloadGroup.className = "sw-download-group";
            downloadGroup.dataset.track = track.track;
            var downloadLabel = document.createElement("span");
            downloadLabel.className = "sw-download-label";
            downloadLabel.textContent = track.label;
            downloadGroup.appendChild(downloadLabel);
            track.files.forEach(function (file) {
              var downloadLink = document.createElement("a");
              downloadLink.className = "sw-download-link";
              downloadLink.href = file.url;
              downloadLink.download = file.filename;
              downloadLink.setAttribute(
                "aria-label", track.label + "を" + file.format + "でダウンロード"
              );
              downloadLink.textContent = file.format;
              downloadGroup.appendChild(downloadLink);
            });
            downloads.appendChild(downloadGroup);
          });
          downloadToggle.addEventListener("click", function () {
            var nextExpanded = downloadToggle.getAttribute("aria-expanded") !== "true";
            downloadExpandedStates[job.id] = nextExpanded;
            downloadToggle.setAttribute("aria-expanded", String(nextExpanded));
            downloads.hidden = !nextExpanded;
          });
          targetBlock.appendChild(downloads);
        } else {
          targetBlock.appendChild(row);
        }
        content.appendChild(targetBlock);
        if (job.status === "error" && job.error) {
          var details = document.createElement("details");
          details.className = "sw-error-details";
          var summary = document.createElement("summary");
          summary.textContent = "失敗の詳細(ログ末尾)";
          details.appendChild(summary);
          var pre = document.createElement("pre");
          pre.textContent = job.error;
          details.appendChild(pre);
          targetBlock.appendChild(details);
        }
      });

      var deleteArea = document.createElement("div");
      deleteArea.className = "sw-delete-area";
      var deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "sw-btn sw-delete-song-btn";
      deleteButton.textContent = "この曲を削除";
      deleteButton.disabled = activePocketJobId !== null
        || songHasActiveJobs(song) || hasActivePocketJobs(songs);
      if (deleteButton.disabled) {
        deleteButton.title = "待機中または処理中のジョブがある曲は削除できません";
      }
      deleteButton.addEventListener("click", function () { openDeleteDialog(song); });
      deleteArea.appendChild(deleteButton);
      content.appendChild(deleteArea);

      li.appendChild(content);

      jobListEl.appendChild(li);
    });

    if (focusedDownloadJobId !== null) {
      var replacementDownloadToggle = Array.prototype.find.call(
        jobListEl.querySelectorAll("button.sw-download-toggle"),
        function (button) { return button.dataset.jobId === focusedDownloadJobId; }
      );
      if (replacementDownloadToggle) {
        replacementDownloadToggle.focus({ preventScroll: true });
      }
    } else if (focusedSongId !== null) {
      var replacementCard = Array.prototype.find.call(
        jobListEl.querySelectorAll("li.sw-job"),
        function (card) { return card.dataset.songId === focusedSongId; }
      );
      if (replacementCard) {
        replacementCard.querySelector("button.sw-job-toggle").focus({ preventScroll: true });
      }
    }
  }

  function hasActiveJobs(songs) {
    return songs.some(function (song) {
      return songHasActiveJobs(song);
    });
  }

  function schedulePoll(jobs) {
    if (pollTimer !== null) {
      clearTimeout(pollTimer);
      pollTimer = null;
    }
    if (hasActiveJobs(jobs) || activePocketJobId !== null) {
      pollTimer = setTimeout(function () { refreshSongs(); }, POLL_INTERVAL_MS);
    }
  }

  function refreshSongs() {
    var hadActivePocket = hasActivePocketJobs(songsCache);
    var hadActiveSeparation = hasActiveSeparationJobs(songsCache);
    return fetch(API_SONGS)
      .then(function (res) { return res.json(); })
      .then(function (songs) {
        renderSongs(songs);
        schedulePoll(songs);
        if (activePocketJobId !== null) refreshActivePocketJob();
        if (hadActivePocket && !hasActivePocketJobs(songs)) refreshPocketStatus();
        if (pocketConnected && hadActiveSeparation && !hasActiveSeparationJobs(songs)) {
          refreshPocketStatus();
        }
        return songs;
      })
      .catch(function () {
        // Transient failure (e.g. server restarting -- exactly the
        // running->queued recovery scenario): keep the last known list on
        // screen and RESCHEDULE ourselves. Without this the poll chain dies
        // on a single failed fetch and a finished job never shows its link.
        if (pollTimer !== null) clearTimeout(pollTimer);
        pollTimer = setTimeout(function () { refreshSongs(); }, POLL_INTERVAL_MS);
      });
  }

  function refreshActivePocketJob() {
    var jobId = activePocketJobId;
    if (jobId === null) return Promise.resolve();
    return fetch(API_JOBS + "/" + encodeURIComponent(jobId))
      .then(function (res) { return res.json(); })
      .then(function (job) {
        renderPocketProgress(job);
        if (job.status === "done" || job.status === "error") {
          renderPocketSummary(job);
          activePocketJobId = null;
          return refreshPocketStatus();
        }
      })
      .catch(function () { return undefined; });
  }

  // Restores what the page should be following without touching the remote
  // shelf: an unreachable Pocket must not delay a reload from picking a
  // running batch back up.
  function refreshPocketJob() {
    var generation = ++pocketJobGeneration;
    return fetch(API_POCKET_JOB)
      .then(function (res) { return res.json(); })
      .then(function (body) {
        if (generation !== pocketJobGeneration) return;
        setPocketConnected(body.connected);
        var job = body.job;
        renderPocketProgress(job);
        if (job && (job.status === "queued" || job.status === "running")) {
          activePocketJobId = job.id;
        } else if (job && (job.status === "done" || job.status === "error")) {
          activePocketJobId = null;
          renderPocketSummary(job);
        }
        renderSongs(songsCache);
        schedulePoll(songsCache);
      })
      .catch(function () { return undefined; });
  }

  function refreshPocketStatus() {
    var generation = ++pocketStatusGeneration;
    pocketChecking = true;
    if (songsCache.length) renderSongs(songsCache);
    return fetch(API_POCKET_STATUS)
      .then(function (res) { return res.json(); })
      .then(function (status) {
        if (generation !== pocketStatusGeneration) return;
        var preserveRemoteOnly = status.connected === true && status.state === "unknown";
        setPocketConnected(status.connected);
        pocketStatuses = Object.create(null);
        if (pocketConnected) {
          (status.songs || []).forEach(function (item) {
            if (item.web_song_id) pocketStatuses[item.web_song_id] = item;
          });
        }
        if (status.state === "unknown") {
          remoteOnlyError.textContent = status.message || "棚の状態を確認できません。";
          remoteOnlyError.hidden = false;
        } else {
          remoteOnlyError.textContent = "";
          remoteOnlyError.hidden = true;
        }
        if (!preserveRemoteOnly) {
          remoteOnlyTracks = pocketConnected ? (status.remote_only || []) : [];
        }
        renderRemoteOnly();
        pocketCountText = "出力先の全パッケージ " + (status.package_count || 0) + "件中、同期対象 " + (status.target_count || 0) + "件";
        renderPocketCount();
      })
      .catch(function () {
        if (generation !== pocketStatusGeneration) return;
        remoteOnlyError.textContent = "棚の状態を確認できません。";
        remoteOnlyError.hidden = false;
        renderRemoteOnly();
      })
      .finally(function () {
        if (generation !== pocketStatusGeneration) return;
        pocketChecking = false;
        renderSongs(songsCache);
        schedulePoll(songsCache);
      });
  }

  function renderRemoteOnly() {
    remoteOnlyList.innerHTML = "";
    remoteOnlySection.hidden = !pocketConnected || remoteOnlyTracks.length === 0;
    remoteOnlyTracks.forEach(function (track) {
      var item = document.createElement("li");
      item.className = "sw-remote-only-item";
      var title = document.createElement("span");
      title.textContent = track.title;
      var id = document.createElement("span");
      id.className = "sw-remote-only-id";
      id.textContent = track.song_id;
      var badge = document.createElement("span");
      badge.className = "sw-badge sw-badge-queued";
      badge.textContent = "棚のみ";
      item.appendChild(title);
      item.appendChild(id);
      item.appendChild(badge);
      remoteOnlyList.appendChild(item);
    });
  }

  pocketAll.addEventListener("click", function () {
    pocketAll.disabled = true;
    postPocket(API_POCKET_SYNC)
      .catch(function (err) { window.alert(err.message || "全曲アップロードを開始できません"); })
      .finally(function () {
        pocketAll.disabled = activePocketJobId !== null || hasActivePocketJobs(songsCache);
      });
  });
  pocketRefresh.addEventListener("click", function () {
    clearPocketSummary();
    refreshPocketStatus();
  });

  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "visible") {
      refreshSongs();
      refreshPocketJob();
      refreshPocketStatus();
    }
  });

  // Test/automation hook, same idea as the player's window.__player: exposes
  // read-only introspection so a headless test can assert on real state
  // (current job list, whether polling is active) instead of guessing from
  // timing.
  window.__bunriWeb = {
    getSongs: function () { return songsCache; },
    getJobs: function () {
      return songsCache.reduce(function (jobs, song) { return jobs.concat(song.targets); }, []);
    },
    isPolling: function () { return pollTimer !== null; },
    refresh: function () {
      return Promise.all([refreshSongs(), refreshPocketJob(), refreshPocketStatus()]);
    }
  };

  refreshPocketJob();
  refreshSongs();
  refreshPocketStatus();
})();
</script>
</body>
</html>
